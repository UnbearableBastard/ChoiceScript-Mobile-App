<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_project_file_middle"
    android:paddingStart="18dp"
    android:paddingEnd="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/imgFileIcon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_document_24"
        app:tint="@color/pb_text_secondary"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/txtFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="startup.txt"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/pb_text_primary"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/txtFileMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1.2 KB – 312 words"
            android:textSize="11sp"
            android:textColor="@color/pb_text_secondary"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnFileMore"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_icon_button_circle"
        android:contentDescription="@null"
        android:padding="5dp"
        android:focusable="false"
        android:clickable="true"
        app:tint="@color/pb_text_secondary"
        android:src="@drawable/abc_ic_menu_overflow_material" />

    <ImageView
        android:id="@+id/dragHandleFile"
        android:layout_width="22dp"
        android:layout_height="30dp"
        android:layout_marginStart="2dp"
        android:padding="3dp"
        android:src="@drawable/ic_grip_24"
        app:tint="@color/pb_text_tertiary"
        android:contentDescription="@null" />

</LinearLayout>
